# ==============================================================================
# Huipper Active eCommerce CMS - Production Environment Configuration Template
# Copy this file to `.env.local` or set these variables in your hosting provider (Vercel / VPS / Coolify)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN (MANDATORY FOR PRODUCTION)
# ------------------------------------------------------------------------------
NODE_ENV="production"

# Your live public website URL (MUST start with https:// and have NO trailing slash)
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# Application Name & Branding
NEXT_PUBLIC_APP_NAME="Active eCommerce"
NEXT_PUBLIC_SITE_MOTTO="Complete Shopping Solution"
NEXT_PUBLIC_CURRENCY_SYMBOL="৳"
NEXT_PUBLIC_CURRENCY_CODE="BDT"
NEXT_PUBLIC_HELPLINE="+880 1700-000000"

# ------------------------------------------------------------------------------
# 2. DATABASE CONNECTION (MANDATORY)
# ------------------------------------------------------------------------------
# PostgreSQL 16+ connection string (e.g. Supabase, Neon, AWS RDS, or local Docker)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://username:password@your-db-host.com:5432/dbname?sslmode=require"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (MANDATORY)
# ------------------------------------------------------------------------------
# Super secure 32+ character random secret for Better Auth session signing & cookies
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-super-secure-better-auth-secret-key-at-least-32-chars"

# Must match your live domain URL exactly
BETTER_AUTH_URL="https://yourdomain.com"

# ------------------------------------------------------------------------------
# 4. SMTP MAIL CONFIGURATION (RECOMMENDED FOR LIVE EMAILS)
# ------------------------------------------------------------------------------
# Can also be managed dynamically via Admin Panel: /admin/settings/smtp
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_USERNAME="your-email@gmail.com"
MAIL_PASSWORD="your-app-specific-password"
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="Active eCommerce"

# ------------------------------------------------------------------------------
# 5. STORAGE & UPLOADS (OPTIONAL)
# ------------------------------------------------------------------------------
# Supported: "local" (default), "cloudinary", or "s3"
STORAGE_DRIVER="cloudinary"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# AWS S3 Settings (if STORAGE_DRIVER="s3")
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"
# AWS_BUCKET="my-ecommerce-assets"
